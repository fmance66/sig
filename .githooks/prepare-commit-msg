#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  exit 0
fi

# Si el usuario ya escribió un mensaje, no lo sobrescribimos.
if [ -s "$msg_file" ] && grep -Eq '^[^#[:space:]].+' "$msg_file" 2>/dev/null; then
  exit 0
fi

changed_files=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if [ -z "$changed_files" ]; then
  changed_files=$(git diff --name-only --diff-filter=ACMR 2>/dev/null || true)
fi

if [ -z "$changed_files" ]; then
  printf '%s\n' 'chore: actualizar proyecto' > "$msg_file"
  exit 0
fi

files_lower=$(printf '%s\n' "$changed_files" | tr '[:upper:]' '[:lower:]')
kind="chore"
summary="actualizar proyecto"

# Reglas de prioridad: mensajes más específicos primero.
if printf '%s\n' "$files_lower" | grep -Eiq '(^|/)(backup|copia|seguridad|restore|respaldo)'; then
  kind="feat"
  summary="implementar copia de seguridad"
elif printf '%s\n' "$files_lower" | grep -Eiq '(^|/)(postgres|mysql|sql|migrations|schema|ddl|migration)'; then
  kind="feat"
  summary="actualizar esquema de base de datos"
elif printf '%s\n' "$files_lower" | grep -Eiq '(^|/)(routes|controllers|models|services|lib|app\.js|server\.js|backend/)'; then
  kind="feat"
  summary="actualizar API del backend"
elif printf '%s\n' "$files_lower" | grep -Eiq '(^|/)(pages|layout|components|app\.jsx|main\.jsx|frontend/|dashboard|login|configuracion|api/)'; then
  kind="feat"
  summary="mejorar interfaz y flujo frontend"
elif printf '%s\n' "$files_lower" | grep -Eiq '(readme|\.md|docs/|documentation)'; then
  kind="docs"
  summary="documentar cambios del proyecto"
elif printf '%s\n' "$files_lower" | grep -Eiq '(package\.json|vite\.config|docker|compose|json|yaml|yml|env|config)'; then
  kind="chore"
  summary="actualizar configuración del proyecto"
fi

# Correcciones sobre archivos problemáticos.
if printf '%s\n' "$files_lower" | grep -Eiq '(fix|bug|error|correg|route|auth|login|session|backup|crash|timeout)'; then
  kind="fix"
  case "$files_lower" in
    *backup*|*copia*|*seguridad*|*respaldo*)
      summary="corregir respaldo y seguridad"
      ;;
    *route*|*api*|*controller*|*server*)
      summary="corregir rutas y API"
      ;;
    *login*|*auth*|*session*)
      summary="corregir autenticación y sesión"
      ;;
    *)
      summary="corregir errores y regressiones"
      ;;
  esac
fi

printf '%s: %s\n' "$kind" "$summary" > "$msg_file"
