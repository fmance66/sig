#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  exit 0
fi

# Si el usuario ya escribió un mensaje, no lo sobrescribimos.
if [ -s "$msg_file" ] && grep -Eq '^[^#[:space:]].+' "$msg_file" 2>/dev/null; then
  exit 0
fi

changed_files=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if [ -z "$changed_files" ]; then
  changed_files=$(git diff --name-only --diff-filter=ACMR 2>/dev/null || true)
fi

kind="chore"
summary="actualizar proyecto"

if printf '%s\n' "$changed_files" | grep -Eiq '(^|/)(backend|src/.*|routes|controllers|models|services|lib)'; then
  kind="feat"
  summary="actualizar backend"
fi

if printf '%s\n' "$changed_files" | grep -Eiq '(^|/)(frontend|src/.*|components|pages|layout|api)'; then
  kind="feat"
  if printf '%s\n' "$changed_files" | grep -Eiq '(^|/)(app|dashboard|config|login|copia|backup)'; then
    summary="actualizar frontend"
  else
    summary="actualizar interfaz"
  fi
fi

if printf '%s\n' "$changed_files" | grep -Eiq '(^|/)(db|migrations|postgres|mysql|sql)'; then
  kind="feat"
  summary="actualizar esquema de datos"
fi

if printf '%s\n' "$changed_files" | grep -Eiq '(backup|copia|seguridad|restore)'; then
  kind="feat"
  summary="agregar respaldo y seguridad"
fi

if printf '%s\n' "$changed_files" | grep -Eiq '(fix|bug|error|correg|route|api|auth|login)'; then
  kind="fix"
  summary="corregir errores"
fi

if printf '%s\n' "$changed_files" | grep -Eiq '(docs|readme|md|documentation)'; then
  kind="docs"
  summary="documentar cambios"
fi

printf '%s: %s\n' "$kind" "$summary" > "$msg_file"
